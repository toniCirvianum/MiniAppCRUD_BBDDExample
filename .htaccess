RewriteEngine On

# El directori del projecte és públic: protegim la configuració d'entorn.
<FilesMatch "^\.env($|\.)">
    Require all denied
</FilesMatch>

# Si el recurs demanat existeix físicament (CSS, imatges, etc.),
# Apache el serveix directament.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# La resta de peticions passen per index.php.
RewriteRule ^ index.php [QSA,L]
